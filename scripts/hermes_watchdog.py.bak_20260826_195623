#!/usr/bin/env python3
"""
Hermes-WebApp Autonomous Watchdog & Keep-Alive Daemon.
Ensures FastAPI server is running 24/7.
If down, automatically starts the server and syncs Cloudflare Telegram Webhook.
"""

import os
import sys
import time
import subprocess
import urllib.request
import logging
from datetime import datetime, timezone

BASE_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LOG_DIR = os.path.join(BASE_DIR, "logs")
os.makedirs(LOG_DIR, exist_ok=True)

LOG_FILE = os.path.join(LOG_DIR, "watchdog.log")
SERVER_LOG_FILE = os.path.join(LOG_DIR, "server.log")

logging.basicConfig(
    filename=LOG_FILE,
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s"
)

PYTHON_EXE = sys.executable
MAIN_SCRIPT = os.path.join(BASE_DIR, "main.py")
UPDATER_SCRIPT = os.path.join(BASE_DIR, "scripts", "cloudflare_webhook_updater.py")

PORTS_TO_CHECK = [9230, 9220, 9225, 9255, 9290, 8080]

def is_server_healthy() -> tuple[bool, int]:
    for port in PORTS_TO_CHECK:
        try:
            url = f"http://127.0.0.1:{port}/api/stats"
            req = urllib.request.Request(url, headers={"User-Agent": "HermesWatchdog/1.0"})
            with urllib.request.urlopen(req, timeout=2) as resp:
                if resp.status == 200:
                    return True, port
        except Exception:
            continue
    return False, 0

def start_server():
    logging.info("Attempting to start Hermes-WebApp server...")
    print("[+] Watchdog: Starting Hermes-WebApp backend server...")
    
    server_log = open(SERVER_LOG_FILE, "a", encoding="utf-8")
    
    # Spawn background server process
    proc = subprocess.Popen(
        [PYTHON_EXE, MAIN_SCRIPT],
        cwd=BASE_DIR,
        stdout=server_log,
        stderr=subprocess.STDOUT,
        creationflags=subprocess.CREATE_NEW_PROCESS_GROUP if sys.platform == "win32" else 0
    )
    logging.info(f"Spawned server process PID {proc.pid}")
    
    # Wait for server to come online
    for i in range(12):
        time.sleep(1)
        healthy, port = is_server_healthy()
        if healthy:
            logging.info(f"Hermes-WebApp server successfully online on port {port} after {i+1}s.")
            print(f"[+] Server online on port {port} after {i+1}s.")
            return True, port
            
    logging.error("Server failed to respond within 12 seconds.")
    print("[-] Server failed to respond within timeout.")
    return False, 0

def run_webhook_sync():
    if os.path.exists(UPDATER_SCRIPT):
        logging.info("Triggering Cloudflare Telegram Webhook updater...")
        print("[+] Triggering Cloudflare Webhook Updater...")
        try:
            subprocess.Popen(
                [PYTHON_EXE, UPDATER_SCRIPT],
                cwd=BASE_DIR,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                creationflags=subprocess.CREATE_NEW_PROCESS_GROUP if sys.platform == "win32" else 0
            )
        except Exception as e:
            logging.error(f"Failed to start webhook updater: {e}")

def check_and_heal():
    healthy, port = is_server_healthy()
    if healthy:
        logging.info(f"Healthcheck PASS: Hermes-WebApp is running on port {port}.")
        print(f"[+] Healthcheck PASS: Hermes-WebApp is online on port {port}.")
        return True
    else:
        logging.warning("Healthcheck FAIL: Hermes-WebApp server is down! Healing...")
        print("[!] Healthcheck FAIL: Server down. Triggering self-healing...")
        success, active_port = start_server()
        if success:
            run_webhook_sync()
        return success

if __name__ == "__main__":
    check_and_heal()
