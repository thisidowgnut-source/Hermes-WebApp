# Hermes OS - Environment Configuration

# Telegram Bot Token (Required for AI Agents and HITL features)
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# WebApp Host Configuration
HOST="127.0.0.1"
PORT=9220

# Allowed CORS Origins (Comma separated)
CORS_ORIGINS="http://localhost:9220,https://my-tunnel.trycloudflare.com"

# WebBridge (GangNiaga proxy 127.0.0.1:10087)
WEBBRIDGE_KEY=your_webbridge_key_here

# Doh-Nut live link (Vercel production storefront)
DOHNUT_API_URL=https://dowgnut-custom.vercel.app
DOHNUT_ADMIN_API_KEY=your_admin_api_key_here
