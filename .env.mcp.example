# MCP Server Environment Variables
# ==================================

# GitHub Integration
GITHUB_TOKEN=your_github_personal_access_token_here

# PostgreSQL Database Connection
PG_CONNECTION_STRING=postgresql://username:password@localhost:5432/database_name

# Firecrawl API (Web Scraping)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# AWS Credentials
AWS_ACCESS_KEY=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# Notion Integration
NOTION_KEY=your_notion_integration_token_here

# Memory Server Persistence
MCP_MEMORY_STORAGE_PATH=/path/to/.mcp-memory

# Docker Settings (if needed)
DOCKER_HOST=tcp://localhost:2375

# Maximum concurrent sessions
MCP_MAX_SESSIONS=5

# Debug mode
MCP_DEBUG=true

# Workspace path (for filesystem server)
WORKSPACE_PATH=/workspace